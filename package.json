    "yoastseo": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@wordpress/scripts": "^30.22.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack-cli": "^5.1.4"
  }
}
