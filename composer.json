{
  "name": "j44mes/zoop",
  "description": "Zoop is a WordPress SEO plugin. Phase 1 scores a rendered page with a deterministic on-page rubric.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^3.9"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.6",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "SEOStudio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SEOStudio\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit --testsuite unit",
    "test:coverage": "phpunit --testsuite unit --coverage-text",
    "test:integration": "phpunit -c phpunit.integration.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
